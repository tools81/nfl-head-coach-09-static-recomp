// Dialog templates for HC09Setup.exe (Wizard97: interior pages 317x143, exterior pages 317x193).
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_SETUP ICON "setup.ico"

IDD_WELCOME DIALOGEX 0, 0, 317, 193
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Welcome"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT "", IDC_TITLE, 115, 8, 195, 24
    LTEXT "", IDC_TEXT, 115, 40, 195, 140
END

IDD_REQUIREMENTS DIALOGEX 0, 0, 317, 143
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Requirements"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT "Everything below must be available before the game can be built.", IDC_REQ_TEXT, 21, 1, 275, 10
    CONTROL "", IDC_REQ_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,
            21, 14, 275, 98
    PUSHBUTTON "&Get selected item...", IDC_REQ_HELP, 21, 118, 90, 14
    PUSHBUTTON "&Check again", IDC_REQ_RECHECK, 226, 118, 70, 14
END

IDD_LOCATION DIALOGEX 0, 0, 317, 143
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Install Location"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT "", IDC_TEXT, 21, 1, 275, 20
    LTEXT "&Folder:", -1, 21, 30, 275, 8
    EDITTEXT IDC_LOC_EDIT, 21, 41, 211, 14, ES_AUTOHSCROLL
    PUSHBUTTON "B&rowse...", IDC_LOC_BROWSE, 238, 41, 58, 14
    LTEXT "", IDC_LOC_INFO, 21, 64, 275, 30
END

IDD_ISO DIALOGEX 0, 0, 317, 143
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Game Disc Image"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT "", IDC_TEXT, 21, 1, 275, 26
    LTEXT "&Disc image (.iso):", -1, 21, 34, 275, 8
    EDITTEXT IDC_ISO_EDIT, 21, 45, 211, 14, ES_AUTOHSCROLL
    PUSHBUTTON "B&rowse...", IDC_ISO_BROWSE, 238, 45, 58, 14
    LTEXT "", IDC_ISO_STATUS, 21, 68, 275, 30
END

IDD_OPTIONS DIALOGEX 0, 0, 317, 143
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Options"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    AUTOCHECKBOX "&Automatically check for updates when the repository publishes a new release", IDC_OPT_UPDATES, 21, 2, 275, 18, BS_MULTILINE | WS_TABSTOP
    LTEXT "", IDC_OPT_UPDATES_TEXT, 33, 22, 263, 34
    AUTOCHECKBOX "Create a &desktop shortcut", IDC_OPT_DESKTOP, 21, 64, 275, 10
END

IDD_READY DIALOGEX 0, 0, 317, 143
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Ready"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    EDITTEXT IDC_READY_TEXT, 21, 1, 275, 130, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | NOT WS_TABSTOP
END

IDD_PROGRESS DIALOGEX 0, 0, 317, 143
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Installing"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT "", IDC_PROG_STEP, 21, 1, 275, 8
    CONTROL "", IDC_PROG_BAR, "msctls_progress32", WS_BORDER, 21, 12, 275, 10
    EDITTEXT IDC_PROG_LOG, 21, 27, 275, 108, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_HSCROLL
END

IDD_FINISH DIALOGEX 0, 0, 317, 193
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Finished"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT "", IDC_TITLE, 115, 8, 195, 24
    LTEXT "", IDC_TEXT, 115, 40, 195, 100
    AUTOCHECKBOX "&Start NFL Head Coach 09 now", IDC_FIN_LAUNCH, 115, 150, 195, 10
END
