// Menu and dialogs of HC09RosterEditor.exe.
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

1 ICON "../installer/setup.ico"

IDR_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "Open HC&27's default roster", IDM_OPEN_DEFAULT
        MENUITEM "&Open a saved roster...\tCtrl+O", IDM_OPEN
        MENUITEM SEPARATOR
        MENUITEM "&Save\tCtrl+S", IDM_SAVE
        MENUITEM SEPARATOR
        MENUITEM "E&xit", IDM_EXIT
    END
    POPUP "&Person"
    BEGIN
        MENUITEM "Change &picture...", IDM_PICTURE
        MENUITEM "&Remove the picture", IDM_PICTURE_REMOVE
        MENUITEM SEPARATOR
        MENUITEM "&Move to a team...", IDM_MOVE
        MENUITEM "Release to the &free agents", IDM_RELEASE
        MENUITEM SEPARATOR
        MENUITEM "Coach &appearance preset...", IDM_PRESET
    END
    POPUP "&Team"
    BEGIN
        MENUITEM "Rebuild the &depth chart by overall rating", IDM_DEPTH
        MENUITEM "Draft &picks...", IDM_PICKS
    END
END

IDR_MENU ACCELERATORS
BEGIN
    "O", IDM_OPEN, VIRTKEY, CONTROL
    "S", IDM_SAVE, VIRTKEY, CONTROL
END

IDD_MOVE DIALOGEX 0, 0, 220, 70
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Choose"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT "", IDC_MOVE_TEXT, 8, 8, 204, 10
    COMBOBOX IDC_MOVE_TEAM, 8, 22, 204, 220, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 106, 48, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 162, 48, 50, 14
END

IDD_PRESET DIALOGEX 0, 0, 220, 170
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Choose"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT "", IDC_MOVE_TEXT, 8, 8, 204, 10
    COMBOBOX IDC_MOVE_TEAM, 8, 22, 204, 220, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "", IDC_MOVE_PREVIEW, "STATIC", SS_BITMAP | SS_CENTERIMAGE, 60, 42, 100, 100
    DEFPUSHBUTTON "OK", IDOK, 106, 148, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 162, 148, 50, 14
END

IDD_PICKS DIALOGEX 0, 0, 330, 300
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Draft picks"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT "&Draft:", -1, 8, 10, 24, 10
    COMBOBOX IDC_PICKS_DRAFT, 34, 8, 150, 100, CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL "", IDC_PICKS_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 8, 26, 314, 196
    LTEXT "&Give the selected picks to:", -1, 8, 230, 100, 10
    COMBOBOX IDC_PICKS_OWNER, 106, 228, 150, 220, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "G&ive", IDC_PICKS_GIVE, 262, 227, 60, 14
    LTEXT "", IDC_PICKS_NOTE, 8, 246, 314, 28
    DEFPUSHBUTTON "Save", IDOK, 216, 279, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 272, 279, 50, 14
END
